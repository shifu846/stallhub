{
  "expo": {
    "name": "StallHub",
    "slug": "stallhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stallhub",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      ["expo-splash-screen", {
        "backgroundColor": "#B8470F",
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 120
      }],
      "expo-secure-store",
      ["expo-image-picker", {
        "cameraPermission": "StallHub uses your camera to photograph event posters.",
        "photosPermission": "StallHub lets you choose a poster photo for your event.",
        "microphonePermission": false
      }],
      ["expo-location", {
        "locationWhenInUsePermission": "StallHub uses your location once to set where your event is held."
      }],
      "expo-notifications"
    ],
    "android": {
      "package": "pg.unitech.stallhub",
      "versionCode": 1,
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#B8470F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "ios": { "bundleIdentifier": "pg.unitech.stallhub" },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "experiments": { "typedRoutes": true, "reactCompiler": true }
  }
}